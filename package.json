{
  "name": "sleeper-draft-assistant",
  "version": "0.1.0-alpha.4",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "desktop": "npm run start -w @sleeper-draft-assistant/desktop",
    "desktop:package": "npm run package -w @sleeper-draft-assistant/desktop",
    "desktop:make": "npm run make -w @sleeper-draft-assistant/desktop",
    "desktop:dist": "npm run dist -w @sleeper-draft-assistant/desktop"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "description": "Unofficial, local-first fantasy football draft and team-management assistant for Sleeper.",
  "author": "Sleeper Draft Assistant contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.6.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/itsreverence/sleeper-draft-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/itsreverence/sleeper-draft-assistant/issues"
  },
  "homepage": "https://github.com/itsreverence/sleeper-draft-assistant#readme"
}
