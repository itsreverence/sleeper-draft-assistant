{
  "name": "@sleeper-draft-assistant/desktop",
  "version": "0.1.0-beta.6",
  "private": true,
  "main": "src/main.cjs",
  "description": "Unofficial, local-first fantasy football draft and team-management assistant for Sleeper.",
  "author": "Sleeper Draft Assistant contributors",
  "scripts": {
    "start": "electron .",
    "test": "vitest run",
    "build:assets": "node ../../scripts/build-desktop-assets.mjs",
    "package": "npm run build:assets && electron-builder --dir",
    "make": "npm run build:assets && electron-builder",
    "dist": "npm run make"
  },
  "build": {
    "appId": "com.itsreverence.sleeperdraftassistant",
    "productName": "Sleeper Draft Assistant",
    "asar": true,
    "asarUnpack": [
      "dist/api-server.mjs"
    ],
    "directories": {
      "output": "out-builder"
    },
    "files": [
      "assets/icon.ico",
      "src/config.cjs",
      "src/main.cjs",
      "src/startup.cjs",
      "dist/**/*",
      "package.json",
      "!dist/THIRD_PARTY_NOTICES.txt"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "extraResources": [
      {
        "from": "dist/THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ],
    "afterPack": "@sleeper-draft-assistant/desktop/after-pack.cjs"
  },
  "devDependencies": {
    "electron": "43.8.3",
    "electron-builder": "26.15.3",
    "vitest": "^4.1.11"
  }
}
